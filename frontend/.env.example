BACKEND_URL=http://127.0.0.1:43124
DATABASE_URL=file:./dev.db
# Leave NEXT_PUBLIC_API_URL empty to call /api on the same origin (Next.js rewrites to the backend).
# Set these only when the API is on a separate public host (Vercel + AWS).
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_WS_URL=wss://api.example.com/ws

